# Copy this file to .env and fill in your values. Never commit .env.

# Upstream Grafana base URL. In development the Vite dev server proxies
# /vicdash-api to this URL (see vite.config.ts).
# `host.docker.internal` resolves to the host from inside the container.
VITE_GRAFANA_URL=http://host.docker.internal:30001

# Bearer token used for `Authorization` against the Grafana HTTP API.
# Create one in Grafana: Administration > Service accounts.
VITE_GRAFANA_TOKEN=glsa_replace_me

# Default datasource UID. Leave empty so Grafana routes to its single/default
# datasource. Set it if your `/api/ds/query` calls return 400.
VITE_GRAFANA_DSUID=