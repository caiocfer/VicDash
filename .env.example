# Copy this file to .env and fill in your values. Never commit .env.

# Upstream Grafana base URL. In development the Vite dev server proxies
# /vicdash-api to this URL (see vite.config.ts).
# `host.docker.internal` resolves to the host from inside the container.
VITE_GRAFANA_URL=http://host.docker.internal:30001

# Bearer token used for `Authorization` against the Grafana HTTP API.
# Create one in Grafana: Administration > Service accounts.
VITE_GRAFANA_TOKEN=glsa_replace_me

# Default datasource UID. Leave empty so Grafana routes to its single/default
# datasource. Set it if your `/api/ds/query` calls return 400.
VITE_GRAFANA_DSUID=

# Home Assistant base URL. In development the Vite dev server proxies
# /vicdash-ha to this URL (see vite.config.ts). Home Assistant listens on
# port 8123 by default.
VITE_HA_URL=http://host.docker.internal:8123

# Long-lived Home Assistant access token. Create one in Home Assistant:
# Profile > Security > Long-lived access tokens. The dashboard controls lights
# (light.*) and the air-conditioner panel (climate.*, switch.*), so the token
# needs service rights on those domains; everything else is read-only.
VITE_HA_TOKEN=